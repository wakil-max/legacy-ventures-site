{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/:page(home|accelerator|incubator|mentors|cohorts|partners|events|studio|faq|about|contact|apply|login|signup|forgot|account)", "destination": "/" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
